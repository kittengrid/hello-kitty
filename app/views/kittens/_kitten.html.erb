<div id="<%= dom_id kitten %>">
  <p>
    <strong>Breed:</strong>
    <%= kitten.breed %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= kitten.name %>
  </p>

  <p>
    <strong>Surname:</strong>
    <%= kitten.surname %>
  </p>

  <p>
    <strong>Date of birth:</strong>
    <%= kitten.date_of_birth %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= kitten.description %>
  </p>

</div>
